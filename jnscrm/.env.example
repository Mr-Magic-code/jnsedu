# ------------------------------------------------------------------
# Backend (NestJS) URL used by the /backend/* proxy rewrite
# ------------------------------------------------------------------
BACKEND_URL=https://your-backend.vercel.app

# ------------------------------------------------------------------
# Must match the JWT_SECRET configured on the backend.
# Optional here: when present, the frontend middleware verifies the JWT
# signature before rendering the dashboard.
# ------------------------------------------------------------------
JWT_SECRET=replace-with-the-same-secret-you-set-on-the-backend

# ------------------------------------------------------------------
# Database (used only by the public /blog pages, server side)
# ------------------------------------------------------------------
DATABASE_HOST=your-db-host
DATABASE_PORT=3306
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_NAME=your-db-name
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_CONNECTION_LIMIT=5

# ------------------------------------------------------------------
# Public site URL used for blog SEO metadata
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
